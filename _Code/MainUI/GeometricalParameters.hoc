// UI
objref hBoxGeometricalParams
// Data vectors
objref vecVolSphereRatio, vecSurfVolRatio, vecDistance, vecVolume, vecSurface, vectDiam, vecDendrDist


objref f1
f1 = new File()

// ============================================================================
// Distance-from-soma metric used by the geometrical-parameter plots.
//   1 = straight-line 2D (XY)   [default, original behaviour]
//   2 = path distance along the arbor (NEURON distance())
//   3 = straight-line 3D (XYZ)
// Selected via the radio buttons in MainUi.hoc ("Distance-from-soma metric").
// ============================================================================
geomDistMode = 1
strdef geomDistAxisLabel
geomDistAxisLabel = "Distance from soma (um)"

// Distance (um) from the soma to the currently accessed section, per geomDistMode.
// Must be called while a section is accessed (inside forall / for eachSecInList),
// and after the distance origin has been set at the soma:
//     soma_ref.o(0).sec distance(0, WHERE)
// A function inherits the caller's currently accessed section, so x3d()/distance()
// here refer to the section being iterated.
func distFromSomaCurSec() {
    if (geomDistMode == 2) {
        return distance(1)                              // path distance along the arbor to the 1-end
    } else if (geomDistMode == 3) {
        return sqrt(x3d(1)^2 + y3d(1)^2 + z3d(1)^2)     // straight-line 3D from origin
    } else {
        return geomMath.len2D(x3d(1), y3d(1))           // straight-line 2D (XY) from origin
    }
}

// Reference "shell" measure for the volume-fraction normalization, per geomDistMode.
// $1 = inner distance (um), $2 = outer distance (um)
//   mode 3: spherical-shell volume (um^3) -> Va/V is a true volume fraction
//   mode 1: annular-disk area    (um^2)   -> Va/A for a planar morphology (not a true volume fraction)
//   mode 2: 1 (no spatial shell for path distance) -> the ratio reduces to the local volume Va
func shellRefMeasure() { local rIn, rOut
    rIn = $1
    rOut = $2
    if (geomDistMode == 3) {
        return 4/3*PI*(rOut^3 - rIn^3)
    } else if (geomDistMode == 2) {
        return 1
    } else {
        return PI*(rOut^2 - rIn^2)
    }
}

// Returns graph with default parameters for all plots.
// $o1 - X data
// $o2 - Y data
// $s3 - Label
// $s4 - Units
// $5 - Boolean. Connect points
obfunc genericGraph() { localobj genericGraph
    genericGraph = new Graph(0)
    genericGraph.yaxis(0)
    genericGraph.label(0.3, 0.1, geomDistAxisLabel, 2, 1, 0, 1, 1)
    genericGraph.label(0.01, 1.0, $s3, 2, 1, 0, 1, 1)
    genericGraph.label(0.5, 0.8, $s4)
    if ($5 > 0) {
        $o1.plot(genericGraph, $o2)
    }
    $o1.mark(genericGraph, $o2, "+", 10)
    genericGraph.view(0, 0, 0, 0, 0, 0, 300, 200)
    genericGraph.exec_menu("View = plot")
    return genericGraph
}

// Caclculates parameters of the current geometry.
proc calculateGeometricalParams() {local i, distanceToCenter, SectionsInside, VolumeSum, SurfaceSum, Radius, Step, distFromSoma, SphereVolume, VolSumTotal, SurSumLoc
    vecVolSphereRatio = new Vector()
    vecSurfVolRatio = new Vector()
    vecDistance = new Vector()
    vecVolume = new Vector()
    vecSurface = new Vector()
    vectDiam = new Vector()
    vecDendrDist = new Vector()

    // !! we set it here and in CommonPrologue.hoc, but in different way (and we export it in different way)
    WHERE = 0.5                             // Location in the soma that is the reference point
    soma_ref.o(0).sec distance(0, WHERE)    // This sets the origin for distance calculations

    // X-axis label depends on the selected metric (path vs straight-line).
    if (geomDistMode == 2) {
        geomDistAxisLabel = "Path distance from soma (um)"
    } else {
        geomDistAxisLabel = "Radial distance from soma (um)"
    }

    SectionsInside = 0
    VolumeSum = 0               // um^3 volume of the local astrosyte
	VolumeMax =0 
    SurfaceSum = 0
	VolSumTotal = 0
	SurSumLoc = 0
    Radius = 0
    Step = 2
    distanceToCenter = 0
    NumberOfSections = 200      // Number of Volume calculations. NumberOfSections*Step should be less than 50.
    
    for i = 1, NumberOfSections {
        forall {
            // Distance from soma per the selected metric (1=2D, 2=path, 3=3D).
            distFromSoma = distFromSomaCurSec()

            // NOTE pre-existing quirk: "Radius" is incremented each i (below) AND "Step*(i-1)" is
            //      added here, so the bins are not contiguous (effectively double-stepping).
            //      Kept as-is to preserve the original 2D results. Comparing the actual distance
            //      against the linear bounds is mathematically identical to the original squared
            //      comparison for mode 1 (sqrt(d^2) > b  <=>  d^2 > b^2, for b >= 0). // !! consider fixing the binning separately
            if (distFromSoma > (Radius+Step*(i-1)) && (distFromSoma < (Radius+Step*i))) {
                SectionsInside += 1
                Volume = PI*L*diam^2/4

                if (diam > 0.2) {
                    Surface = PI*diam*L+2*PI*diam^2/4
                } else {
                    Surface = PI*diam*L
                }

                distanceToCenter = distFromSoma
                VolumeSum += Volume
                SurfaceSum += Surface
                VolSumTotal += Volume
                SurSumLoc += Surface
            }

            // Mode-aware normalization reference (sphere volume / annulus area / none).
            SphereVolume = shellRefMeasure(distanceToCenter, distanceToCenter+Step)
        }

        if (SectionsInside < 2) {
            SectionsInside = 0
        } else {
            vecDistance.append(distanceToCenter)
            vecSurfVolRatio.append(SurfaceSum/VolumeSum)
            vecVolSphereRatio.append(VolumeSum/SphereVolume)
            vecVolume.append(VolSumTotal)
            vecSurface.append(SurSumLoc)
        }

        Radius = Radius+Step
		VolumeMax=VolumeMax+VolumeSum
        SectionsInside = 0
        VolumeSum = 0
        SurfaceSum = 0
        SphereVolume = 0
    }
    print(VolumeMax)
	VolumeMax=0
	TotalLength=0
	totalDiameter=0
//	f1.wopen("filedata.txt")
    for eachSecInList(dendrite_ref) {
        vectDiam.append(diam)
		//	TotalLength=TotalLength+L
		//	totalDiameter=totalDiameter+diam
		//	print i, L, diam, TotalLength, totalDiameter
		//	f1.printf("%-6.3g %-6.3g %-6.3g %-6.3g %-6.3g", i, L, diam, TotalLength, totalDiameter)
		//	f1.printf("\n")
        vecDendrDist.append(distFromSomaCurSec())   // same metric as the radial plots (was geomMath.len2D(x3d(1), y3d(1)))
    }
//	closeFileAndShowCompleteMsg(f1)
}

// Plots geometrical parameters and show them.
proc plotGeometricalParams() {
    strdef volFracLabel, volFracUnits

    // The volume-fraction normalization differs per metric (see shellRefMeasure).
    if (geomDistMode == 3) {
        volFracLabel = "Volume tissue fraction (3D)"
        volFracUnits = "Ln(Va/V)"
    } else if (geomDistMode == 2) {
        volFracLabel = "Local volume per bin (path)"
        volFracUnits = "Ln(Va)"
    } else {
        volFracLabel = "Volume / annulus area (2D)"
        volFracUnits = "Ln(Va/A)"
    }

    hBoxGeometricalParams = new HBox()
    hBoxGeometricalParams.intercept(1)
    {
        genericGraph(vecSurfVolRatio, vecDistance, "Surface/Volume Ratio", "1/um", 1)
        genericGraph(vecVolSphereRatio.log(), vecDistance, volFracLabel, volFracUnits, 1)
        genericGraph(vecVolume, vecDistance, "Total volume", "um3", 1)
        genericGraph(vecSurface, vecDistance, "Total surface area", "um2", 1)
        genericGraph(vectDiam, vecDendrDist, "Branch diameter", "um", 0)
    }
    hBoxGeometricalParams.intercept(0)
    hBoxGeometricalParams.map("Geometrical Parameters")
}

// Prints geometrical params to file.
// NOTE Call before plotGeometricalParams() because of log() call
// $o1 - File to print data to
proc printGeometricalParamsToFile() { local i
    $o1.printf("L\t\t\tV_Ratio\t\tVolume\t\tSurface\t\tSurface/Volume\n")
    for i=0, vecVolSphereRatio.size()-1 {
        $o1.printf("%-8.4g\t%-8.4g\t%-8.4g\t%-8.4g\t%-8.4g\n", vecDistance.x[i], vecVolSphereRatio.x[i], vecVolume.x[i], vecSurface.x[i], vecSurfVolRatio.x[i])
    }
}

// Calculates and shows parameters of current geometry.
proc GeometricalParameters() { localobj fileForData
    strdef outTxtFileRelPathName
    
    outTxtFileRelPathName = "Text results/VolumFraction.txt"
    
    calculateGeometricalParams()
    
    fileForData = new File()
    fileForData.aopen(outTxtFileRelPathName)
    printGeometricalParamsToFile(fileForData)
    
    plotGeometricalParams()
    
    closeFileAndShowCompleteMsg(fileForData)
}
